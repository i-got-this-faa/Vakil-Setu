{
  "expo": {
    "name": "Legal-Setu",
    "slug": "legal-setu",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "legalsetu",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.legalsetu.app"
    },
    "android": {
      "package": "in.legalsetu.app",
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4f46e5"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Legal-Setu listens only while you press the microphone button, so it can understand your problem.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Legal-Setu uses the camera so you can photograph a legal paper, like a notice or FIR, and have it explained.",
          "photosPermission": "Legal-Setu opens your photos so you can choose a picture of a legal paper to have it explained."
        }
      ]
    ]
  }
}
