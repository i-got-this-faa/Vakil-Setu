PORT=5000
MONGO_URI=your_mongo_connection

# Needed only when fetching/refreshing official statute HTML with Firecrawl.
FIRECRAWL_API_KEY=your_firecrawl_key

# Optional absolute path for downloaded legal PDFs, text and the retrieval corpus.
# Default: backend/data/legal (gitignored).
# LEGAL_CORPUS_DIR=/absolute/path/to/legal-corpus

# LLM provider switch: gateway | gemini
LLM_PROVIDER=gateway
# gateway: MIET-issued token (e.g. dgx_...). gemini: Google AI key (AIza...) only if LLM_PROVIDER=gemini
LLM_API_KEY=your_gateway_or_gemini_api_key
LLM_MODEL=qwen3:latest
LLM_API_URL=/gateway/llm/chat
LLM_API_KEY_HEADER=Authorization
LLM_API_KEY_PREFIX=Bearer

# For college-hosted gateway routes
GATEWAY_BASE_URL=https://ai-services.mietjmu.in

# Gemini configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro
LLM_FALLBACK_MODE=rule_based

# Optional payment
RAZORPAY_KEY=your_key
RAZORPAY_SECRET=your_secret

# Scraper input (comma-separated listing URLs)
SCRAPE_URLS=https://example.com/lawyers
SCRAPE_MAX_PAGES=3
SCRAPE_PROFILE_DEPTH=10
SCRAPE_DRY_RUN=false

# Standalone WhatsApp backend. Demo needs none of the credentials below.
WHATSAPP_MODE=demo
WHATSAPP_PORT=5001
# Twilio Sandbox is the immediate live integration; Meta is also supported.
WHATSAPP_PROVIDER=twilio
# Twilio presentation only: allow explicitly fictional profiles and local-only requests.
WHATSAPP_DEMO_ADVOCATES=false
# Optional absolute directory; default backend/data/whatsapp-demo or whatsapp-live.
# WHATSAPP_DATA_DIR=/absolute/path/to/whatsapp-data

# For WHATSAPP_MODE=live and WHATSAPP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Copy the exact Sandbox sender from your Twilio console, including whatsapp:+.
TWILIO_WHATSAPP_FROM=
# Public HTTPS origin from your deployment/tunnel, without a path or trailing slash.
PUBLIC_BASE_URL=

# For WHATSAPP_MODE=live only. Choose a supported Graph version from your Meta app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
# A long random value chosen by you and also entered in Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=

# A provider implementing /audio/transcriptions and /audio/speech.
# local: English Whisper tiny.en plus offline speech/FFmpeg; no speech API key.
# api: configure the API values below and evaluate the selected languages.
SPEECH_PROVIDER=local
# SPEECH_LANGUAGES=en,hi
# WHATSAPP_PYTHON=/absolute/path/to/python-with-faster-whisper
# Base URL includes any API version prefix. Models and voice depend on your provider.
SPEECH_API_BASE_URL=
SPEECH_API_KEY=
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# extractive reads source excerpts; llm uses the existing model config and validation.
LEGAL_REPLY_MODE=extractive
# Optional JSON array of verified, non-demo advocate profiles; otherwise none are offered.
# WHATSAPP_ADVOCATE_MANIFEST=/absolute/path/to/verified-advocates.json

# Local multilingual semantic retrieval; auto uses hybrid when a current index exists.
LEGAL_RETRIEVAL_MODE=auto
LEGAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Download/cache the model explicitly with npm run legal:embed; requests stay offline.

# Triage includes source evidence. auto generates only when LLM_API_KEY exists.
# extractive always returns source excerpts; llm attempts generation then excerpts on provider failure.
TRIAGE_RAG_MODE=auto
